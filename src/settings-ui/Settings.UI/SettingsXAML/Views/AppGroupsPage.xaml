<local:NavigablePage
    x:Class="Microsoft.PowerToys.Settings.UI.Views.AppGroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.PowerToys.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Microsoft.PowerToys.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Microsoft.PowerToys.Settings.UI.ViewModels"
    AutomationProperties.LandmarkType="Main"
    mc:Ignorable="d">

    <controls:SettingsPageControl
        x:Uid="AppGroups"
        IsTabStop="False"
        ModuleImageSource="ms-appx:///Assets/Settings/Modules/AppGroups.png">
        <controls:SettingsPageControl.ModuleContent>
            <StackPanel ChildrenTransitions="{StaticResource SettingsCardsAnimations}" Orientation="Vertical">

                <tkcontrols:SettingsCard x:Uid="AppGroups_EnableToggleControl_HeaderText" HeaderIcon="{ui:BitmapIcon Source=/Assets/Settings/Icons/AppGroups.png}">
                    <ToggleSwitch x:Uid="ToggleSwitch" IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                </tkcontrols:SettingsCard>

                <InfoBar
                    x:Uid="AppGroups_TaskbarUnsupported"
                    Margin="0,8,0,0"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsTaskbarPinningUnsupported, Mode=OneWay}"
                    Severity="Warning" />

                <InfoBar
                    x:Uid="AppGroups_InfoBar"
                    Margin="0,8,0,8"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />

                <controls:SettingsGroup x:Uid="AppGroups_GroupsSettingsGroup" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                    <tkcontrols:SettingsCard x:Uid="AppGroups_RestartExplorer" HeaderIcon="{ui:FontIcon Glyph=&#xE72C;}">
                        <ToggleSwitch
                            IsEnabled="{x:Bind ViewModel.IsTaskbarPinningSupported, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.RestartExplorerAfterApplying, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>

                    <tkcontrols:SettingsCard x:Uid="AppGroups_Actions" HeaderIcon="{ui:FontIcon Glyph=&#xE710;}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="AppGroups_AddGroupButton"
                                Command="{x:Bind ViewModel.AddGroupCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Uid="AppGroups_ApplyAllButton" Command="{x:Bind ViewModel.ApplyAllCommand}" />
                        </StackPanel>
                    </tkcontrols:SettingsCard>

                    <InfoBar
                        Margin="0,8,0,0"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=OneWay}"
                        Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Severity="Informational" />

                    <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:AppGroupViewModel">
                                <tkcontrols:SettingsExpander Margin="0,0,0,8" IsExpanded="True">
                                    <tkcontrols:SettingsExpander.Header>
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Name, Mode=OneWay}" />
                                    </tkcontrols:SettingsExpander.Header>
                                    <tkcontrols:SettingsExpander.Items>
                                        <tkcontrols:SettingsCard x:Uid="AppGroups_GroupName" HeaderIcon="{ui:FontIcon Glyph=&#xE8AC;}">
                                            <TextBox
                                                MinWidth="{StaticResource SettingActionControlMinWidth}"
                                                Text="{x:Bind Name, Mode=TwoWay}" />
                                        </tkcontrols:SettingsCard>

                                        <tkcontrols:SettingsCard x:Uid="AppGroups_ShowOnDesktop" HeaderIcon="{ui:FontIcon Glyph=&#xE8FC;}">
                                            <ToggleSwitch IsOn="{x:Bind ShowOnDesktop, Mode=TwoWay}" />
                                        </tkcontrols:SettingsCard>

                                        <tkcontrols:SettingsCard x:Uid="AppGroups_PinToTaskbar" HeaderIcon="{ui:FontIcon Glyph=&#xE840;}">
                                            <ToggleSwitch
                                                IsEnabled="{x:Bind IsTaskbarPinningSupported, Mode=OneWay}"
                                                IsOn="{x:Bind PinToTaskbar, Mode=TwoWay}" />
                                        </tkcontrols:SettingsCard>

                                        <tkcontrols:SettingsCard
                                            x:Uid="AppGroups_Apps"
                                            HorizontalContentAlignment="Stretch"
                                            ContentAlignment="Vertical">
                                            <StackPanel Spacing="4">
                                                <ItemsControl ItemsSource="{x:Bind Apps, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:AppGroupAppViewModel">
                                                            <Grid ColumnSpacing="8" Padding="0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                                        Text="{x:Bind Path}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Button
                                                                    Grid.Column="1"
                                                                    x:Uid="AppGroups_RemoveAppButton"
                                                                    Command="{x:Bind RemoveCommand}"
                                                                    VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock
                                                    x:Uid="AppGroups_NoApps"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Visibility="{x:Bind HasNoApps, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

                                                <Button x:Uid="AppGroups_AddAppButton" Margin="0,8,0,0" Click="AddApps_Click" />
                                            </StackPanel>
                                        </tkcontrols:SettingsCard>

                                        <tkcontrols:SettingsCard>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button
                                                    x:Uid="AppGroups_ApplyButton"
                                                    Command="{x:Bind ApplyCommand}"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                                <Button x:Uid="AppGroups_DeleteButton" Command="{x:Bind RemoveCommand}" />
                                            </StackPanel>
                                        </tkcontrols:SettingsCard>
                                    </tkcontrols:SettingsExpander.Items>
                                </tkcontrols:SettingsExpander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </controls:SettingsGroup>
            </StackPanel>
        </controls:SettingsPageControl.ModuleContent>
    </controls:SettingsPageControl>
</local:NavigablePage>
